---
layout: layouts/base.ejs
title: Get a Free Quote
description: "Request a free, no-obligation cleaning quote from The Right Clean in Edmonton. Tell us about your space and we'll get back to you."
permalink: /quote/
---
<%
  const telHref = helpers.telHref(site.phone);
  const propertyTypes = ['Home or apartment', 'Office', 'Medical or dental clinic', 'New build / construction site', 'Other'];
  const heardAbout = ['Google search', 'Facebook', 'Instagram', 'Friend or family', 'Other'];
  const req = '<span class="req" aria-hidden="true">*</span>';
%>
<section class="page-hero pb-5">
  <div class="container">
    <div class="row g-4 align-items-end">
      <div class="col-lg-7">
        <span class="kicker"><%- include('/partials/star') %>Free quote</span>
        <h1 class="mb-0">Let's get your space <em>sparkling.</em></h1>
      </div>
      <div class="col-lg-5">
        <p class="lead mb-0">Tell us about your space and we'll get back to you with a free, no-obligation quote.</p>
      </div>
    </div>
  </div>
</section>

<section class="section section-paper pt-0">
  <div class="container">
    <div class="quote-shell">
      <!-- Form -->
      <div class="quote-main">
          <h2 class="h3 mb-1">Request your quote</h2>
          <p class="text-muted small mb-4">Fields marked <span class="req">*</span> are required.</p>

          <form id="quote-form" class="quote-form" action="https://api.web3forms.com/submit" method="POST">
            <input type="hidden" name="access_key" value="<%= site.web3formsKey %>">
            <input type="hidden" name="subject" value="New quote request — <%= site.name %>">
            <input type="hidden" name="from_name" value="<%= site.name %> website">
            <input type="hidden" name="redirect" value="<%= site.url %>/thank-you/">
            <!-- Spam trap: humans never see or fill this -->
            <input type="checkbox" name="botcheck" class="d-none" tabindex="-1" autocomplete="off">

            <div id="form-errors" class="form-error-summary" role="alert" aria-live="assertive" tabindex="-1" hidden></div>

            <div class="row g-3">
              <div class="col-12">
                <label for="f-name" class="form-label">Full name <%- req %></label>
                <input id="f-name" name="name" type="text" class="form-control" autocomplete="name" required aria-describedby="f-name-error">
                <div id="f-name-error" class="invalid-feedback">Please enter your name.</div>
              </div>
              <div class="col-md-6">
                <label for="f-phone" class="form-label">Phone <%- req %></label>
                <input id="f-phone" name="phone" type="tel" class="form-control" autocomplete="tel" required minlength="7" aria-describedby="f-phone-error">
                <div id="f-phone-error" class="invalid-feedback">Please enter a phone number we can reach you on.</div>
              </div>
              <div class="col-md-6">
                <label for="f-email" class="form-label">Email <%- req %></label>
                <input id="f-email" name="email" type="email" class="form-control" autocomplete="email" required aria-describedby="f-email-error">
                <div id="f-email-error" class="invalid-feedback">Please enter a valid email address.</div>
              </div>

              <div class="col-md-6">
                <label for="f-service" class="form-label">Service <%- req %></label>
                <select id="f-service" name="service" class="form-select" required aria-describedby="f-service-error">
                  <option value="">Choose a service</option>
                  <% services.forEach(s => { %>
                  <option value="<%= s.title %>" data-slug="<%= s.slug %>"><%= s.title %></option>
                  <% }) %>
                  <option value="Not sure / other">Not sure / other</option>
                </select>
                <div id="f-service-error" class="invalid-feedback">Please choose a service.</div>
              </div>
              <div class="col-md-6">
                <label for="f-property" class="form-label">Property type</label>
                <select id="f-property" name="property_type" class="form-select">
                  <option value="">Choose one</option>
                  <% propertyTypes.forEach(p => { %><option><%= p %></option><% }) %>
                </select>
              </div>

              <div class="col-md-6">
                <label for="f-size" class="form-label">Approximate size (sq ft)</label>
                <input id="f-size" name="size_sq_ft" type="number" class="form-control" min="0" step="1" inputmode="numeric">
              </div>
              <div class="col-md-6">
                <label for="f-date" class="form-label">Preferred date</label>
                <input id="f-date" name="preferred_date" type="date" class="form-control">
              </div>

              <div class="col-12">
                <label for="f-address" class="form-label">Address or area <%- req %></label>
                <input id="f-address" name="address" type="text" class="form-control" autocomplete="street-address" required aria-describedby="f-address-hint f-address-error">
                <div id="f-address-hint" class="form-text">A full address or just your neighbourhood is fine.</div>
                <div id="f-address-error" class="invalid-feedback">Please tell us where the space is.</div>
              </div>

              <div class="col-12">
                <label for="f-details" class="form-label">Details</label>
                <textarea id="f-details" name="details" class="form-control" rows="5" placeholder="Number of rooms, condition, anything we should know" aria-describedby="f-details-hint"></textarea>
                <div id="f-details-hint" class="form-text"><i class="bi bi-camera me-1" aria-hidden="true"></i>Have photos? Mention it and we'll ask for them when we reply.</div>
              </div>

              <div class="col-12">
                <label for="f-heard" class="form-label">How did you hear about us?</label>
                <select id="f-heard" name="heard_about" class="form-select">
                  <option value="">Choose one</option>
                  <% heardAbout.forEach(h => { %><option><%= h %></option><% }) %>
                </select>
              </div>

              <div class="col-12">
                <div class="form-check">
                  <input id="f-consent" name="consent" type="checkbox" class="form-check-input" value="Yes" required aria-describedby="f-consent-error">
                  <label for="f-consent" class="form-check-label">I agree to be contacted about my quote request. <%- req %> (<a href="/privacy/">Privacy Policy</a>)</label>
                  <div id="f-consent-error" class="invalid-feedback">Please agree so we can contact you about your quote.</div>
                </div>
              </div>

              <div class="col-12">
                <% if (helpers.isTodo(site.web3formsKey)) { %><p><%- include('/partials/todo', { label: 'Add Web3Forms key to site.json — form will not send yet' }) %></p><% } %>
                <button type="submit" class="btn btn-primary btn-lg submit-btn">
                  <span class="btn-label">Send my quote request</span> <i class="bi bi-arrow-right" aria-hidden="true"></i>
                </button>
              </div>
            </div>
          </form>
      </div>

      <!-- Contact panel -->
      <aside class="quote-aside on-dark" aria-labelledby="contact-heading">
          <span class="kicker"><%- include('/partials/star') %>Prefer to talk?</span>
          <h2 id="contact-heading" class="h3 mb-3">We're happy to <em>help.</em></h2>
          <p class="mb-0">Reach us directly with any question about your space.</p>
          <ul class="contact-list">
            <li>
              <div>
                <span class="contact-label"><%= site.phoneCanText ? 'Call or text' : 'Call' %></span>
                <% if (telHref) { %><a href="<%= telHref %>"><%= site.phone %></a><% } else { %><%- include('/partials/todo', { label: 'Add phone number' }) %><% } %>
              </div>
            </li>
            <li>
              <div>
                <span class="contact-label">Email</span>
                <a href="mailto:<%= site.email %>"><%= site.email %></a>
                <% if (!site.emailConfirmed) { %><br><%- include('/partials/todo', { label: 'Confirm email works' }) %><% } %>
              </div>
            </li>
            <li>
              <div>
                <span class="contact-label">Service area</span>
                <% if (helpers.isTodo(site.serviceArea)) { %><%- include('/partials/todo', { label: 'Add service area' }) %><% } else { %><%= site.serviceArea %><% } %>
              </div>
            </li>
            <li>
              <div>
                <span class="contact-label">Hours</span>
                <% if (helpers.isTodo(site.hours)) { %><%- include('/partials/todo', { label: 'Add business hours' }) %><% } else { %><%= site.hours %><% } %>
              </div>
            </li>
          </ul>
          <div class="d-flex gap-2 mt-2">
            <a class="btn btn-outline-light btn-sm" href="<%= site.socials.facebook %>" target="_blank" rel="noopener"><i class="bi bi-facebook me-1" aria-hidden="true"></i>Facebook<span class="visually-hidden"> (opens in new tab)</span></a>
            <a class="btn btn-outline-light btn-sm" href="<%= site.socials.instagram %>" target="_blank" rel="noopener"><i class="bi bi-instagram me-1" aria-hidden="true"></i>Instagram<span class="visually-hidden"> (opens in new tab)</span></a>
          </div>
      </aside>
    </div>
  </div>
</section>

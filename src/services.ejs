---
layout: layouts/base.ejs
title: Our Services
description: "Commercial, move-in/move-out, post construction, floor care, carpet and medical/dental cleaning from The Right Clean in Edmonton. See what's included and get a free quote."
permalink: /services/
---
<% const shortTitle = (t) => t.replace(/\s*\(.*\)$/, ''); %>
<section class="page-head">
  <div class="container">
    <h1 class="mb-3">Services</h1>
    <p class="lead">Six kinds of cleaning, each with its own checklist. Routine or deep cleaning, booked around your schedule. Every quote is free.</p>
  </div>
</section>

<nav class="service-nav" aria-label="Jump to a service">
  <div class="container">
    <ul>
      <% services.forEach(service => { %><li><a href="#<%= service.slug %>"><%= shortTitle(service.title) %></a></li><% }) %>
    </ul>
  </div>
</nav>

<%# "includes" checklists in services.json are standard industry scope; confirm with client. %>
<% services.forEach((service, i) => { const flip = i % 2 === 1; %>
<section class="section service-section<%= flip ? ' section-paper' : '' %>" id="<%= service.slug %>" aria-labelledby="<%= service.slug %>-heading">
  <div class="container">
    <div class="row g-4 g-lg-5 align-items-center">
      <div class="col-lg-6<%= flip ? ' order-lg-2' : '' %>">
        <div class="photo ratio-4x3">
          <%- include('/partials/picture', { name: service.image, alt: service.imageAlt, sizes: '(min-width: 992px) 50vw, 100vw', eager: i === 0 }) %>
        </div>
      </div>
      <div class="col-lg-6">
        <h2 id="<%= service.slug %>-heading" class="mb-3"><%= service.title %></h2>
        <p class="mb-4"><%= service.longText %></p>
        <h3 class="h4 mb-2">What's included</h3>
        <ul class="checklist">
          <% service.includes.forEach(item => { %><li><%= item %></li><% }) %>
        </ul>
        <a class="btn btn-primary" href="/quote/?service=<%= service.slug %>">Get a quote for <%= shortTitle(service.title).toLowerCase() %></a>
      </div>
    </div>
  </div>
</section>
<% }) %>

<section class="section pb-0">
  <div class="container">
    <div class="help-box">
      <div>
        <h2 class="h3 mb-2">Not sure what you need?</h2>
        <p class="text-muted mb-md-0">Describe the space and what's bothering you. We'll suggest the right clean and send you a free quote.</p>
      </div>
      <a class="btn btn-dark btn-lg flex-shrink-0" href="/quote/">Ask us</a>
    </div>
  </div>
</section>

<%- include('/partials/quote-cta') %>

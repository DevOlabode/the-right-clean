<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title && title !== site.name ? `${title} | ${site.name}` : site.name %></title>
<% if (typeof description !== 'undefined' && description) { %><meta name="description" content="<%= description %>"><% } %>
<% if (site.preview) { %><meta name="robots" content="noindex, nofollow"><% } %>
<meta name="theme-color" content="#0F3D5E">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@600;700&display=swap">
<link rel="stylesheet" href="/assets/vendor/bootstrap/bootstrap.min.css">
<link rel="stylesheet" href="/assets/vendor/bootstrap-icons/bootstrap-icons.min.css">
<link rel="stylesheet" href="/assets/css/main.css">

<a class="service-card" href="/services/#<%= service.slug %>">
  <div class="frame-img"><%- include('/partials/picture', { name: service.image, alt: '' }) %></div>
  <span class="go" aria-hidden="true"><i class="bi bi-arrow-up-right"></i></span>
  <div class="service-card-body">
    <span class="service-num"><%= String(index + 1).padStart(2, '0') %></span>
    <h3><%= service.title.replace(/\s*\(.*\)$/, '') %></h3>
    <p><%= service.shortText %></p>
  </div>
</a>

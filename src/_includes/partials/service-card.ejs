<a class="service-card" href="/services/#<%= service.slug %>">
  <div class="photo"><%- include('/partials/picture', { name: service.image, alt: '', sizes: '(min-width: 992px) 33vw, (min-width: 768px) 50vw, 100vw' }) %></div>
  <div class="service-card-body">
    <h3><%= service.title %></h3>
    <p><%= service.shortText %></p>
    <span class="link-more">What's included <%- helpers.icon('arrow-right') %></span>
  </div>
</a>

<% const phoneHref = helpers.telHref(site.phone); %>
<footer class="site-footer">
  <div class="container">
    <div class="row g-4 g-lg-5">
      <div class="col-lg-4">
        <a class="footer-logo" href="/">
          <img src="/assets/images/logo-wide.jpg" width="540" height="330" alt="<%= site.name %> home" loading="lazy">
        </a>
        <p class="mt-3 mb-0" style="max-width: 22rem;"><%= site.tagline %> Commercial, specialty and move-in/move-out cleaning in <%= helpers.isTodo(site.serviceArea) ? 'your area' : site.serviceArea %>.</p>
      </div>
      <div class="col-6 col-lg-2">
        <h2>Pages</h2>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/services/">Services</a></li>
          <li><a href="/about/">About</a></li>
          <li><a href="/quote/">Get a free quote</a></li>
        </ul>
      </div>
      <div class="col-12 col-sm-6 col-lg-4">
        <h2>Contact</h2>
        <ul class="footer-contact">
          <li><%- helpers.icon('telephone') %>
            <div><% if (phoneHref) { %><a href="<%= phoneHref %>"><%= site.phone %></a><% } else { %><%- include('/partials/todo', { label: 'Add phone number' }) %><% } %></div>
          </li>
          <li><%- helpers.icon('envelope') %>
            <div>
              <a href="mailto:<%= site.email %>"><%= site.email %></a>
              <% if (!site.emailConfirmed) { %><br><%- include('/partials/todo', { label: 'Confirm email works' }) %><% } %>
            </div>
          </li>
          <li><%- helpers.icon('clock') %>
            <div><% if (helpers.isTodo(site.hours)) { %><%- include('/partials/todo', { label: 'Add business hours' }) %><% } else { %><%= site.hours %><% } %></div>
          </li>
        </ul>
      </div>
      <div class="col-6 col-lg-2">
        <h2>Follow</h2>
        <div class="social-links d-flex gap-2">
          <a href="<%= site.socials.facebook %>" target="_blank" rel="noopener" aria-label="<%= site.name %> on Facebook (opens in new tab)"><%- helpers.icon('facebook') %></a>
          <a href="<%= site.socials.instagram %>" target="_blank" rel="noopener" aria-label="<%= site.name %> on Instagram (opens in new tab)"><%- helpers.icon('instagram') %></a>
        </div>
      </div>
    </div>
    <div class="footer-bottom d-flex flex-column flex-md-row justify-content-between gap-2">
      <p class="mb-0">&copy; <%= helpers.year %> <%= site.name %> · <a href="/privacy/">Privacy</a></p>
      <% if (site.preview) { %><p class="mb-0">Preview built by Samuel Olabode</p><% } %>
    </div>
  </div>
</footer>

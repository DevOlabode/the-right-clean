<% const callHref = helpers.telHref(site.phone); %>
<div class="mobile-cta-bar" aria-label="Quick contact" role="region">
  <% if (callHref) { %>
  <a class="btn btn-outline-primary" href="<%= callHref %>"><i class="bi bi-telephone" aria-hidden="true"></i> Call</a>
  <% } %>
  <a class="btn btn-primary" href="/quote/">Get a Quote <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
</div>

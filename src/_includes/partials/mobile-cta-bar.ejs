<% const callHref = helpers.telHref(site.phone); %>
<div class="mobile-cta-bar" aria-label="Quick contact" role="region">
  <% if (callHref) { %>
  <a class="btn btn-outline-primary" href="<%= callHref %>"><%- helpers.icon('telephone') %> Call</a>
  <% } %>
  <a class="btn btn-primary" href="/quote/">Get a quote <%- helpers.icon('arrow-right') %></a>
</div>

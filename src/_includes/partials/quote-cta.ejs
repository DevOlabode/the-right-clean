<% const ctaTel = helpers.telHref(site.phone); %>
<section class="section on-dark cta-band" aria-labelledby="quote-cta-heading">
  <%- include('/partials/star', { cls: 'bg-star' }) %>
  <div class="container position-relative">
    <div class="row g-4 g-lg-5 align-items-end">
      <div class="col-lg-7 reveal">
        <span class="kicker"><%- include('/partials/star') %>Free, no-obligation quotes</span>
        <h2 id="quote-cta-heading" class="display mb-4">Ready for <em>The Right Clean?</em></h2>
        <p class="lead mw-34 mb-4">Tell us about your space and we'll get back to you with a clear quote that fits it.</p>
        <div class="d-flex flex-wrap gap-2">
          <a class="btn btn-light btn-lg" href="/quote/">Get a Free Quote <%- helpers.icon('arrow-right') %></a>
          <% if (ctaTel) { %><a class="btn btn-outline-light btn-lg" href="<%= ctaTel %>"><%- helpers.icon('telephone') %> <%= site.phone %></a><% } %>
        </div>
      </div>
      <div class="col-lg-5 reveal reveal-delay-1">
        <ul class="cta-details">
          <li><span class="label">Area</span><span class="value"><% if (helpers.isTodo(site.serviceArea)) { %><%- include('/partials/todo', { label: 'Add service area' }) %><% } else { %><%= site.serviceArea %><% } %></span></li>
          <li><span class="label">Hours</span><span class="value"><% if (helpers.isTodo(site.hours)) { %><%- include('/partials/todo', { label: 'Add business hours' }) %><% } else { %><%= site.hours %><% } %></span></li>
          <li><span class="label">Email</span><span class="value"><a href="mailto:<%= site.email %>"><%= site.email %></a></span></li>
        </ul>
      </div>
    </div>
  </div>
</section>

<%# Light "get a quote + hours" block. Kept light on purpose so the footer is the only dark block. %>
<% const ctaTel = helpers.telHref(site.phone); const week = helpers.weekHours(site.openingHoursSchema); %>
<section class="section section-mist" aria-labelledby="quote-cta-heading">
  <div class="container">
    <div class="row g-4 g-lg-5 align-items-center">
      <div class="col-lg-6">
        <h2 id="quote-cta-heading" class="mb-3">Get a free quote</h2>
        <p class="lead mb-4">Tell us about your space and we'll send you a clear price for it. No cost and no obligation.</p>
        <div class="d-flex flex-wrap gap-2">
          <a class="btn btn-primary btn-lg" href="/quote/">Request a quote <%- helpers.icon('arrow-right') %></a>
          <% if (ctaTel) { %><a class="btn btn-outline-dark btn-lg" href="<%= ctaTel %>"><%- helpers.icon('telephone') %> <%= site.phoneCanText ? 'Call or text' : 'Call' %> <%= site.phone %></a><% } %>
        </div>
      </div>
      <div class="col-lg-5 offset-lg-1">
        <div class="visit-card">
          <dl class="mb-3">
            <dt>Service area</dt>
            <dd><% if (helpers.isTodo(site.serviceArea)) { %><%- include('/partials/todo', { label: 'Add service area' }) %><% } else { %><%= site.serviceArea %><% } %></dd>
          </dl>
          <p class="label mb-1 mt-3">Hours</p>
          <% if (helpers.isTodo(site.openingHoursSchema)) { %><%- include('/partials/todo', { label: 'Add business hours' }) %><% } else { %>
          <table class="hours-table" data-hours-table>
            <caption class="visually-hidden">Business hours</caption>
            <tbody>
              <% week.forEach(d => { %><tr data-day="<%= d.key %>"><th scope="row"><%= d.day %></th><td><%= d.label %></td></tr><% }) %>
            </tbody>
          </table>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</section>

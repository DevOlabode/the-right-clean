---
layout: layouts/base.ejs
title: About Us
description: "Meet Gbemisola Famade and the team at The Right Clean: more than 7 years in cleaning, built on trust, consistent quality and peace of mind."
permalink: /about/
preloadImage: portrait-placeholder
---
<%
  const firstName = site.owner.split(' ')[0];
  const teamPoints = ['Trained', 'Quality-checked'];
  if (site.insured === true) teamPoints.splice(1, 0, 'Insured');
  const values = [
    { title: 'Teamwork', text: 'We work together on every job, so nothing gets missed and the work gets done well.' },
    { title: 'Reliability', text: 'We show up when we say we will and clean to the same standard every time.' },
    { title: 'Attention to detail', text: 'The small things matter. We notice them, so you can see the difference.' },
  ];
%>
<section class="page-head">
  <div class="container">
    <h1 class="mb-3">About The Right Clean</h1>
    <p class="lead">A cleaning company built on trust, consistent quality and peace of mind.</p>
  </div>
</section>

<section class="section" aria-labelledby="story-heading">
  <div class="container">
    <div class="row g-4 g-lg-5">
      <div class="col-md-5 col-lg-4">
        <figure class="mb-0">
          <div class="photo ratio-4x5 object-top">
            <%- include('/partials/picture', { name: 'portrait-placeholder', alt: `${site.owner}, owner of ${site.name}`, width: 1024, height: 1536, eager: true }) %>
          </div>
          <figcaption class="mt-2 small text-muted"><strong class="text-ink"><%= site.owner %></strong>, owner</figcaption>
        </figure>
      </div>
      <div class="col-md-7 col-lg-7 offset-lg-1">
        <h2 id="story-heading" class="mb-4">Hello, I'm <%= firstName %>.</h2>
        <p class="lead text-ink">I'm the proud owner of <%= site.name %> and, above all, a lover of God.</p>
        <p>I've worked in the cleaning industry for more than <%= site.yearsExperience %> years. It started with hands-on work cleaning homes, offices and commercial spaces, and it taught me one thing: quality should be visible, and consistency should never be compromised.</p>
        <p>Along the way I learned that clients want more than a clean space. They want peace of mind, and to know their space is in good hands. That idea shapes how we clean, the standards we set and how we treat every client.</p>
        <p>Our promise, "<%= site.tagline %>", is the standard we hold ourselves to on every job.</p>
        <p class="mb-0">Thank you to every client who has trusted us. Your support and feedback help us keep getting better.</p>
      </div>
    </div>
  </div>
</section>

<section class="section section-paper" aria-labelledby="team-heading">
  <div class="container">
    <div class="row g-4 g-lg-5 align-items-center">
      <div class="col-lg-6">
        <h2 id="team-heading" class="mb-3">The team</h2>
        <p>Our cleaners are <%= teamPoints.join(', ').toLowerCase().replace(/, ([^,]*)$/, ' and $1') %>. Every team member gets proper training and regular quality checks, so you get the same thorough results on every visit.</p>
        <p class="mb-3">We have specialists in deep cleaning, office cleaning and floor care, and the right tools and products for each job.</p>
        <div class="d-flex flex-wrap gap-2">
          <% teamPoints.forEach(p => { %><span class="tag"><%- helpers.icon('check-lg') %><%= p %></span><% }) %>
        </div>
      </div>
      <div class="col-lg-6">
        <div class="photo ratio-4x3">
          <%- include('/partials/picture', { name: 'office-corridor', alt: 'A spotless, bright office corridor with glass walls', sizes: '(min-width: 992px) 50vw, 100vw' }) %>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section" aria-labelledby="values-heading">
  <div class="container">
    <h2 id="values-heading" class="mb-4 mb-lg-5">What we care about</h2>
    <div class="values">
      <% values.forEach(v => { %><div><h3><%= v.title %></h3><p><%= v.text %></p></div><% }) %>
    </div>
    <p class="lead text-ink mt-5 mb-0" style="max-width: 44rem;">"Cleaning isn't just about the space we leave behind. It's about the confidence, comfort and peace of mind we create." <span class="text-muted">— <%= firstName %></span></p>
  </div>
</section>

<%- include('/partials/quote-cta') %>

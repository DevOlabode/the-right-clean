---
layout: layouts/base.ejs
title: About Us
description: "The Right Clean is run by Gbemisola Famade, who has worked in cleaning for over 7 years. Trained, insured cleaners for offices, clinics and move-outs in Edmonton."
permalink: /about/
preloadImage: portrait-placeholder
---
<%
  const firstName = site.owner.split(' ')[0];
  const tel = helpers.telHref(site.phone);
%>
<section class="page-head">
  <div class="container">
    <h1 class="mb-0">About</h1>
  </div>
</section>

<section class="section" aria-labelledby="story-heading">
  <div class="container">
    <div class="row g-4 g-lg-5">
      <div class="col-md-5 col-lg-4">
        <figure class="mb-0">
          <div class="photo ratio-4x5 object-top">
            <%- include('/partials/picture', { name: 'portrait-placeholder', alt: `${site.owner}, owner of ${site.name}`, width: 1024, height: 1536, eager: true }) %>
          </div>
          <figcaption class="mt-2 small text-muted"><strong class="text-ink"><%= site.owner %></strong>, owner</figcaption>
        </figure>
      </div>
      <div class="col-md-7 col-lg-7 offset-lg-1">
        <%# Wording below is Gbemisola's own, from the old site, lightly trimmed. %>
        <h2 id="story-heading" class="mb-4">Hello, I'm <%= firstName %>.</h2>
        <p>I'm the owner of <%= site.name %> and, above all, a lover of God.</p>
        <p>I've been in the cleaning industry for over <%= site.yearsExperience %> years. I started with hands-on work, cleaning homes, offices and commercial spaces, and that's what grew into this business.</p>
        <p>My rule is that quality should be visible, and consistency should never be compromised. That's where our name comes from: the right clean, every time.</p>
        <p class="mb-0">I'm grateful to every client who has trusted <%= site.name %>, and I still want to hear from you when something could be better.</p>
      </div>
    </div>
  </div>
</section>

<section class="section section-paper" aria-labelledby="team-heading">
  <div class="container">
    <div class="row g-4 g-lg-5 align-items-center">
      <div class="col-lg-6">
        <h2 id="team-heading" class="mb-3">The team</h2>
        <p>Every cleaner is trained<%= site.insured === true ? ' and insured' : '' %>, and their work gets checked. Some of the team specialise in deep cleaning, office cleaning or floor care.</p>
        <p class="mb-0">We bring the tools and products for the job.</p>
      </div>
      <div class="col-lg-6">
        <div class="photo ratio-4x3">
          <%- include('/partials/picture', { name: 'office-corridor', alt: 'An office corridor', sizes: '(min-width: 992px) 50vw, 100vw' }) %>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section" aria-label="Contact">
  <div class="container">
    <p class="lead text-ink mb-0" style="max-width: 40rem;">Want a price for your space? <a href="/quote/">Send us the details</a><% if (tel) { %>, or <%= site.phoneCanText ? 'call or text' : 'call' %> <a href="<%= tel %>"><%= site.phone %></a><% } %>.</p>
  </div>
</section>

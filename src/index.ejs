---
layout: layouts/base.ejs
title: The Right Clean
description: "Professional cleaning you can trust in Edmonton: commercial, move-in/move-out, post construction, floor care, carpet and medical/dental cleaning. Get a free quote."
permalink: /
preloadImage: hero-office-vacuum
preloadWidth: 1800
preloadSizes: "(min-width: 992px) 50vw, 100vw"
---
<%
  const tel = helpers.telHref(site.phone);
  const firstName = site.owner.split(' ')[0];
  const area = helpers.isTodo(site.serviceArea) ? '' : site.serviceArea;
  const points = ['Trained, quality-checked team', 'Free quotes, priced for your space'];
  if (site.insured === true) points.unshift('Insured');
  const shortTitle = (t) => t.replace(/\s*\(.*\)$/, '');
  const steps = [
    { title: 'Tell us about the space', text: 'What it is, roughly how big, and what needs doing. The form takes about two minutes, or just call or text.' },
    { title: 'Get your price', text: "We get back to you with a clear, free quote for your space." },
    { title: 'We clean, you check', text: "Our team does the work and checks it before we leave. If something's missed, tell us." },
  ];
  const faqs = [
    { q: 'Why aren\'t prices listed?', a: 'Every space is different. A two-bedroom move-out and a dental clinic are very different jobs, so we quote each one. Quotes are free.' },
    { q: 'Where do you clean?', a: area ? `${area}. If you're not sure you're in our area, ask.` : null },
    { q: 'When do you work?', a: helpers.isTodo(site.hours) ? null : `${site.hours}.` },
    { q: 'Are you insured?', a: site.insured === true ? `Yes. ${site.name} is insured, and every team member is trained and quality-checked.` : null },
  ].filter(f => f.a);
%>

<section class="hero">
  <div class="container">
    <div class="row g-4 g-lg-5 align-items-center">
      <div class="col-lg-6">
        <h1 class="mb-4">Professional cleaning you can trust.</h1>
        <p class="lead mb-4">Offices, medical and dental clinics, new builds and move-in/move-out cleans<%= area ? ` across ${area}` : '' %>. Run by <%= site.owner %>, with <%= site.yearsExperience %>+ years in the cleaning industry.</p>
        <div class="d-flex flex-wrap gap-2">
          <a class="btn btn-primary btn-lg" href="/quote/">Get a free quote</a>
          <a class="btn btn-outline-dark btn-lg" href="/services/">See our services</a>
        </div>
        <ul class="hero-points">
          <% points.forEach(p => { %><li><%- helpers.icon('check-circle-fill') %><%= p %></li><% }) %>
        </ul>
      </div>
      <div class="col-lg-6">
        <div class="photo ratio-4x3">
          <%- include('/partials/picture', { name: 'hero-office-vacuum', alt: 'A cleaner vacuuming a bright, glass-walled office', width: 1800, height: 1440, sizes: '(min-width: 992px) 50vw, 100vw', eager: true }) %>
        </div>
      </div>
    </div>
  </div>
</section>

<% if (!helpers.isTodo(site.openingHoursSchema) || tel) { %>
<div class="info-strip">
  <div class="container d-flex flex-wrap align-items-center gap-2">
    <% if (!helpers.isTodo(site.openingHoursSchema)) { %>
    <span class="open-status" data-open-status data-hours='<%- JSON.stringify(helpers.weekHours(site.openingHoursSchema).map(d => [d.open, d.close])) %>'><%= site.hours %></span>
    <% } %>
    <% if (area) { %><span class="sep d-none d-md-inline" aria-hidden="true">|</span><span class="d-none d-md-inline"><%= area %></span><% } %>
    <% if (tel) { %><span class="ms-md-auto"><%= site.phoneCanText ? 'Call or text' : 'Call' %> <a href="<%= tel %>"><%= site.phone %></a></span><% } %>
  </div>
</div>
<% } %>

<section class="section" aria-labelledby="services-heading">
  <div class="container">
    <div class="section-head-row">
      <h2 id="services-heading">What we clean</h2>
      <p>Routine or deep cleaning, booked around your schedule. Not sure which one you need? <a href="/quote/">Ask us.</a></p>
    </div>
    <div class="row g-3 g-lg-4">
      <% services.forEach(service => { %>
      <div class="col-md-6 col-lg-4"><%- include('/partials/service-card', { service }) %></div>
      <% }) %>
    </div>
  </div>
</section>

<section class="section section-paper" aria-labelledby="included-heading">
  <div class="container">
    <div class="section-head">
      <h2 id="included-heading" class="mb-3">What's included</h2>
      <p class="lead mb-0">Every clean follows a checklist, so nothing gets missed. Pick a service to see the standard list.</p>
    </div>
    <%# Checklists are standard industry scope (services.json); confirm with client. %>
    <div class="included" data-tabs>
      <div class="included-tabs" role="tablist" aria-label="Services">
        <% services.forEach((s, i) => { %>
        <button type="button" role="tab" id="tab-<%= s.slug %>" aria-controls="panel-<%= s.slug %>" aria-selected="<%= i === 0 %>"<%- i ? ' tabindex="-1"' : '' %>><%= shortTitle(s.title) %></button>
        <% }) %>
      </div>
      <% services.forEach((s, i) => { %>
      <div class="included-panel" role="tabpanel" id="panel-<%= s.slug %>" aria-labelledby="tab-<%= s.slug %>">
        <h3><%= s.title %></h3>
        <p class="text-muted mb-3"><%= s.shortText %></p>
        <ul class="checklist">
          <% s.includes.forEach(item => { %><li><%= item %></li><% }) %>
        </ul>
        <div class="d-flex flex-wrap align-items-center gap-3">
          <a class="btn btn-primary" href="/quote/?service=<%= s.slug %>">Get a quote for this</a>
          <p class="included-note">Need something added? Mention it in your quote request.</p>
        </div>
      </div>
      <% }) %>
    </div>
  </div>
</section>

<section class="section" aria-labelledby="clinic-heading">
  <div class="container">
    <div class="row g-4 g-lg-5 align-items-center">
      <div class="col-lg-6 order-lg-2">
        <h2 id="clinic-heading" class="mb-3">Medical and dental clinics</h2>
        <p class="lead">A higher standard of clean for spaces dedicated to care.</p>
        <p>Clinics need careful, detailed cleaning. We pay close attention to exam rooms, waiting areas, washrooms and every surface people touch.</p>
        <a class="link-more" href="/services/#specialty-cleaning">How we clean clinics <%- helpers.icon('arrow-right') %></a>
      </div>
      <div class="col-lg-6 order-lg-1">
        <div class="photo ratio-4x3">
          <%- include('/partials/picture', { name: 'dental-room-clean', alt: 'A clean, bright dental treatment room', sizes: '(min-width: 992px) 50vw, 100vw' }) %>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section section-paper" aria-labelledby="note-heading">
  <div class="container">
    <div class="note-card mx-auto" style="max-width: 50rem;">
      <h2 id="note-heading" class="mb-3">Hi, I'm <%= firstName %>.</h2>
      <p>I've spent more than <%= site.yearsExperience %> years in the cleaning industry, starting with homes, offices and commercial spaces. The biggest thing I learned is that people want more than a clean space. They want to know it's in good hands.</p>
      <p class="mb-0">That's what The Right Clean is built on: a trained team, the same high standard every visit, and someone you can actually call if you have a question.</p>
      <div class="sign">
        <img src="/assets/images/portrait-avatar.jpg" width="56" height="56" alt="">
        <div><strong><%= site.owner %></strong><span>Owner · <a href="/about/">Read our story</a></span></div>
      </div>
    </div>
  </div>
</section>

<section class="section" aria-labelledby="steps-heading">
  <div class="container">
    <h2 id="steps-heading" class="mb-4 mb-lg-5">How it works</h2>
    <ol class="steps">
      <% steps.forEach(s => { %><li><h3><%= s.title %></h3><p><%= s.text %></p></li><% }) %>
    </ol>
  </div>
</section>

<% if (reviews.length) { %>
<section class="section section-paper" aria-labelledby="reviews-heading">
  <div class="container">
    <h2 id="reviews-heading" class="mb-4">What clients say</h2>
    <div class="row g-4">
      <% reviews.forEach(review => { %>
      <div class="col-md-6 col-lg-4">
        <figure class="note-card h-100 mb-0">
          <blockquote class="mb-3"><p class="mb-0"><%= review.text %></p></blockquote>
          <figcaption><strong class="text-ink"><%= review.name %></strong><% if (review.service) { %><span class="d-block text-muted small"><%= review.service %></span><% } %></figcaption>
        </figure>
      </div>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<% if (faqs.length) { %>
<section class="section<%= reviews.length ? '' : ' pt-0' %>" aria-labelledby="faq-heading">
  <div class="container">
    <h2 id="faq-heading" class="mb-4 mb-lg-5">Before you ask</h2>
    <div class="faq">
      <% faqs.forEach(f => { %><div><h3><%= f.q %></h3><p><%= f.a %></p></div><% }) %>
    </div>
  </div>
</section>
<% } %>

<%- include('/partials/quote-cta') %>

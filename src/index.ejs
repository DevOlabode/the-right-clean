---
layout: layouts/base.ejs
title: The Right Clean
description: "Office, clinic, move-out and post-construction cleaning in Edmonton and surrounding areas. Run by Gbemisola Famade. Call or text for a free quote."
permalink: /
preloadImage: hero-office-vacuum
preloadWidth: 1800
preloadSizes: "(min-width: 992px) 50vw, 100vw"
---
<%
  const tel = helpers.telHref(site.phone);
  const firstName = site.owner.split(' ')[0];
  const area = helpers.isTodo(site.serviceArea) ? '' : site.serviceArea;
  const city = area ? area.split(' and ')[0] : '';
  const shortTitle = (t) => t.replace(/\s*\(.*\)$/, '');
  const groups = [
    { key: 'business', title: 'For businesses and clinics' },
    { key: 'one-time', title: 'One-time cleans' },
    { key: 'floors', title: 'Floors and carpets' },
  ];
  const faqs = [
    { q: 'How much does it cost?', a: "It depends on the space, so we quote each job. Send a few details through the form or text us, and we'll come back with a price." },
    { q: 'Do you come out to my area?', a: area ? `We work across ${area}. If you're on the edge of that, ask anyway.` : null },
    { q: 'Are you insured?', a: site.insured === true ? 'Yes.' : null },
  ].filter(f => f.a);
%>

<section class="hero">
  <div class="container">
    <div class="row g-4 g-lg-5 align-items-center">
      <div class="col-lg-6">
        <h1 class="mb-4">Office, clinic and move-out cleaning<%= city ? ` in ${city}` : '' %>.</h1>
        <p class="lead mb-4"><%= site.name %> is run by <%= site.owner %>. She's spent <%= site.yearsExperience %> years cleaning homes, offices and commercial spaces, and now runs a trained, insured team.</p>
        <div class="d-flex flex-wrap gap-2">
          <a class="btn btn-primary btn-lg" href="/quote/">Get a free quote</a>
          <% if (tel) { %><a class="btn btn-outline-dark btn-lg" href="<%= tel %>"><%= site.phoneCanText ? 'Call or text' : 'Call' %> <%= site.phone %></a><% } %>
        </div>
      </div>
      <div class="col-lg-6">
        <div class="photo ratio-4x3">
          <%- include('/partials/picture', { name: 'hero-office-vacuum', alt: 'A cleaner vacuuming an office', width: 1800, height: 1440, sizes: '(min-width: 992px) 50vw, 100vw', eager: true }) %>
        </div>
      </div>
    </div>
  </div>
</section>

<% if (!helpers.isTodo(site.openingHoursSchema)) { %>
<div class="info-strip">
  <div class="container d-flex flex-wrap align-items-center gap-2">
    <span class="open-status" data-open-status data-hours='<%- JSON.stringify(helpers.weekHours(site.openingHoursSchema).map(d => [d.open, d.close])) %>'><%= site.hours %></span>
    <% if (area) { %><span class="sep d-none d-md-inline" aria-hidden="true">|</span><span class="d-none d-md-inline"><%= area %></span><% } %>
  </div>
</div>
<% } %>

<section class="section" aria-labelledby="services-heading">
  <div class="container">
    <h2 id="services-heading" class="mb-4 mb-lg-5">What we clean</h2>
    <div class="service-groups">
      <% groups.forEach(g => { const list = services.filter(s => s.group === g.key); %>
      <div class="service-group">
        <h3 class="label mb-3"><%= g.title %></h3>
        <ul class="service-list">
          <% list.forEach(s => { %>
          <li>
            <a href="/services/#<%= s.slug %>">
              <span class="name"><%= shortTitle(s.title) %></span>
              <span class="desc"><%= s.shortText %></span>
            </a>
          </li>
          <% }) %>
        </ul>
      </div>
      <% }) %>
    </div>
  </div>
</section>

<section class="section section-paper" aria-labelledby="included-heading">
  <div class="container">
    <div class="section-head">
      <h2 id="included-heading" class="mb-3">The checklist</h2>
      <p class="lead mb-0">This is what a standard clean covers for each service. If your space needs something else, put it in the quote form.</p>
    </div>
    <%# Checklists are standard industry scope (services.json); confirm with client. %>
    <div class="included" data-tabs>
      <div class="included-tabs" role="tablist" aria-label="Services">
        <% services.forEach((s, i) => { %>
        <button type="button" role="tab" id="tab-<%= s.slug %>" aria-controls="panel-<%= s.slug %>" aria-selected="<%= i === 0 %>"<%- i ? ' tabindex="-1"' : '' %>><%= shortTitle(s.title) %></button>
        <% }) %>
      </div>
      <% services.forEach((s, i) => { %>
      <div class="included-panel" role="tabpanel" id="panel-<%= s.slug %>" aria-labelledby="tab-<%= s.slug %>">
        <h3 class="mb-3"><%= s.title %></h3>
        <ul class="checklist">
          <% s.includes.forEach(item => { %><li><%= item %></li><% }) %>
        </ul>
        <a class="link-more" href="/quote/?service=<%= s.slug %>">Get a quote for <%= shortTitle(s.title).toLowerCase() %> <%- helpers.icon('arrow-right') %></a>
      </div>
      <% }) %>
    </div>
  </div>
</section>

<section class="section" aria-labelledby="clinic-heading">
  <div class="container">
    <div class="row g-4 g-lg-5 align-items-center">
      <div class="col-lg-6 order-lg-2">
        <h2 id="clinic-heading" class="mb-3">Medical and dental clinics</h2>
        <p>Clinics get a different clean from an office. Exam and treatment rooms, the front desk and waiting area, and washrooms are cleaned and disinfected, with extra care on the handles, counters and chairs people touch all day.</p>
        <a class="link-more" href="/services/#specialty-cleaning">What's on the clinic checklist <%- helpers.icon('arrow-right') %></a>
      </div>
      <div class="col-lg-6 order-lg-1">
        <div class="photo ratio-4x3">
          <%- include('/partials/picture', { name: 'dental-room-clean', alt: 'A dental treatment room', sizes: '(min-width: 992px) 50vw, 100vw' }) %>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section section-paper" aria-labelledby="note-heading">
  <div class="container">
    <div class="note-card mx-auto" style="max-width: 50rem;">
      <h2 id="note-heading" class="mb-3">Hi, I'm <%= firstName %>.</h2>
      <p>I started out doing the cleaning myself, in homes, offices and commercial spaces. After <%= site.yearsExperience %> years, the thing I'm strictest about is consistency. The clean you get on the tenth visit should look exactly like the first one.</p>
      <p class="mb-0">If something isn't right, call or text me<%= tel ? ` at ${site.phone}` : '' %>.</p>
      <div class="sign">
        <img src="/assets/images/portrait-avatar.jpg" width="56" height="56" alt="">
        <div><strong><%= site.owner %></strong><span>Owner · <a href="/about/">More about us</a></span></div>
      </div>
    </div>
  </div>
</section>

<% if (reviews.length) { %>
<section class="section" aria-labelledby="reviews-heading">
  <div class="container">
    <h2 id="reviews-heading" class="mb-4">What clients say</h2>
    <div class="row g-4">
      <% reviews.forEach(review => { %>
      <div class="col-md-6 col-lg-4">
        <figure class="note-card h-100 mb-0">
          <blockquote class="mb-3"><p class="mb-0"><%= review.text %></p></blockquote>
          <figcaption><strong class="text-ink"><%= review.name %></strong><% if (review.service) { %><span class="d-block text-muted small"><%= review.service %></span><% } %></figcaption>
        </figure>
      </div>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<% if (faqs.length) { %>
<section class="section" aria-labelledby="faq-heading">
  <div class="container">
    <h2 id="faq-heading" class="mb-4 mb-lg-5">Questions people ask</h2>
    <div class="faq">
      <% faqs.forEach(f => { %><div><h3><%= f.q %></h3><p><%= f.a %></p></div><% }) %>
    </div>
  </div>
</section>
<% } %>

<%- include('/partials/quote-cta') %>
